local function pushLog(text)
	local stamp = os.date("%H:%M:%S")
	local line = string.format("[%s] %s", stamp, tostring(text))
	print(line)
	if logLabel then
		if logLabel.Text == "" then
			logLabel.Text = line
		else
			logLabel.Text = logLabel.Text .. "\n" .. line
		end
		local lines = string.split(logLabel.Text, "\n")
		if #lines > 120 then
			table.remove(lines, 1)
			logLabel.Text = table.concat(lines, "\n")
		end
	end
end

local function setStatus(text, color)
	if statusLabel then
		statusLabel.Text = text
		if color then
			statusLabel.TextColor3 = color
		end
	end
end

local function hasFileIO()
	return typeof(writefile) == "function" and typeof(readfile) == "function" and typeof(isfile) == "function"
end

local function markEntrySeen(entryKey)
	if State.seenEntries[entryKey] then
		return false
	end
	State.seenEntries[entryKey] = true
	table.insert(State.seenOrder, entryKey)
	if #State.seenOrder > MAX_SEEN_ENTRIES then
		local oldest = table.remove(State.seenOrder, 1)
		if oldest then
			State.seenEntries[oldest] = nil
		end
	end
	return true
end

local function saveConfig(overrideRunning)
	if not hasFileIO() then
		return
	end
	local payload = {
		running = (overrideRunning ~= nil) and overrideRunning or State.running,
		foundCount = State.foundCount,
		seenOrder = State.seenOrder,
		autoBuy = State.autoBuy,
		autoTeleport = State.autoTeleport,
		skinDelay = State.skinDelay,
		loopDelay = State.loopDelay,
		tpWait = State.tpWait,
		minPrice = State.minPrice,
		targets = State.targets,
	}
	local ok, encoded = pcall(HttpService.JSONEncode, HttpService, payload)
	if ok and type(encoded) == "string" then
		pcall(writefile, CONFIG_FILE, encoded)
	end
end

local function setRunning(val, shouldSave)
	State.running = val
	if toggleRunBtn then
		if State.running then
			toggleRunBtn.Text = "STOP"
			toggleRunBtn.BackgroundColor3 = Color3.fromRGB(185, 58, 65)
			setStatus("RUNNING", Color3.fromRGB(85, 220, 130))
		else
			toggleRunBtn.Text = "START"
			toggleRunBtn.BackgroundColor3 = Color3.fromRGB(46, 160, 98)
			setStatus("STOPPED", Color3.fromRGB(160, 170, 190))
		end
	end
	if shouldSave then
		saveConfig()
	end
end

local function loadConfig()
	if not hasFileIO() then
		return false
	end
	local existsOk, exists = pcall(isfile, CONFIG_FILE)
	if not existsOk or not exists then
		return false
	end
	local rOk, raw = pcall(readfile, CONFIG_FILE)
	if not rOk or type(raw) ~= "string" then
		return false
	end
	local dOk, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
	if dOk and type(decoded) == "table" then
		if type(decoded.autoBuy) == "boolean" then State.autoBuy = decoded.autoBuy end
		if type(decoded.autoTeleport) == "boolean" then State.autoTeleport = decoded.autoTeleport end
		if tonumber(decoded.skinDelay) then State.skinDelay = math.max(0.05, tonumber(decoded.skinDelay)) end
		if tonumber(decoded.loopDelay) then State.loopDelay = math.max(0.05, tonumber(decoded.loopDelay)) end
		if tonumber(decoded.tpWait) then State.tpWait = math.max(1, tonumber(decoded.tpWait)) end
		if tonumber(decoded.minPrice) then State.minPrice = math.max(0, tonumber(decoded.minPrice)) end
		if tonumber(decoded.foundCount) then State.foundCount = math.max(0, tonumber(decoded.foundCount)) end

		if type(decoded.seenOrder) == "table" then
			State.seenEntries = {}
			State.seenOrder = {}
			for _, key in ipairs(decoded.seenOrder) do
				if type(key) == "string" then
					markEntrySeen(key)
				end
			end
		end

		if type(decoded.targets) == "table" then
			local cleanTargets = {}
			for k, v in pairs(decoded.targets) do
				local num = tonumber(v)
				if type(k) == "string" and k ~= "" and num and num > 0 then
					cleanTargets[k] = num
				end
			end
			if next(cleanTargets) ~= nil then
				State.targets = cleanTargets
			end
		end

		if refreshTargetsUI then
			refreshTargetsUI()
		end
		refreshSettingsUI()
		updateFoundCounter()

		local wasRunning = decoded.running == true
		pushLog("Config загружен | Найдено: " .. tostring(State.foundCount))
		return wasRunning
	end
	return false
end

local function findSellerPlayer(item)
	if typeof(item.Seller) == "Instance" and item.Seller:IsA("Player") then
		return item.Seller
	end
	if item.SellerUserId ~= nil then
		local uid = tonumber(item.SellerUserId)
		if uid then
			return Players:GetPlayerByUserId(uid)
		end
	end
	if type(item.SellerName) == "string" then
		return Players:FindFirstChild(item.SellerName)
	end
	return nil
end

