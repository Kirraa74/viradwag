local function hasFileIO()
	return typeof(writefile) == "function" and typeof(readfile) == "function" and typeof(isfile) == "function"
end

local function markEntrySeen(entryKey)
	if State.seenEntries[entryKey] then
		return false
	end
	State.seenEntries[entryKey] = true
	table.insert(State.seenOrder, entryKey)
	if #State.seenOrder > MAX_SEEN_ENTRIES then
		local oldest = table.remove(State.seenOrder, 1)
		if oldest then
			State.seenEntries[oldest] = nil
		end
	end
	return true
end

local function isJobCoolingDown(jobId)
	local untilTime = State.badJobIds[jobId]
	if not untilTime then
		return false
	end
	if os.clock() >= untilTime then
		State.badJobIds[jobId] = nil
		return false
	end
	return true
end

local function markJobBad(jobId)
	if type(jobId) == "string" and jobId ~= "" then
		State.badJobIds[jobId] = os.clock() + State.tpCooldown
	end
end

local function saveConfig(overrideRunning)
	if not hasFileIO() then
		return
	end
	local payload = {
		running = (overrideRunning ~= nil) and overrideRunning or State.running,
		foundCount = State.foundCount,
		boughtCount = State.boughtCount,
		prioritySkin = State.prioritySkin,
		hotkey = State.hotkey,
		seenOrder = State.seenOrder,
		autoBuy = State.autoBuy,
		autoTeleport = State.autoTeleport,
		soundAlert = State.soundAlert,
		skinDelay = State.skinDelay,
		loopDelay = State.loopDelay,
		tpWait = State.tpWait,
		tpCooldown = State.tpCooldown,
		buyRetries = State.buyRetries,
		minPrice = State.minPrice,
		targets = State.targets,
	}
	local ok, encoded = pcall(HttpService.JSONEncode, HttpService, payload)
	if ok and type(encoded) == "string" then
		pcall(writefile, CONFIG_FILE, encoded)
	end
end

