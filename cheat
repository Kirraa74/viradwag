	lbl.BackgroundTransparency = 1
	lbl.Font = Enum.Font.GothamSemibold
	lbl.TextSize = 12
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.TextColor3 = Color3.fromRGB(235, 238, 245)
	lbl.Text = labelText
	lbl.Parent = row

	local box = Instance.new("TextBox")
	box.Size = UDim2.new(0, 74, 0, 22)
	box.Position = UDim2.new(1, -82, 0.5, -11)
	box.BackgroundColor3 = Color3.fromRGB(22, 25, 33)
	box.Font = Enum.Font.GothamBold
	box.TextSize = 12
	box.TextColor3 = Color3.fromRGB(255, 255, 255)
	box.Text = tostring(getValue())
	box.ClearTextOnFocus = false
	box.Parent = row
	Instance.new("UICorner", box).CornerRadius = UDim.new(0, 5)

	local function paint()
		box.Text = tostring(getValue())
	end
	table.insert(settingsRefreshers, paint)

	box.FocusLost:Connect(function()
		local num = tonumber(box.Text)
		if num then
			if minVal then
				num = math.max(minVal, num)
			end
			onChange(num)
			saveConfig()
		end
		paint()
	end)
end

