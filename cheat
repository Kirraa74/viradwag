local function switchTab(activeIndex)
	pageTargets.Visible = (activeIndex == 1)
	pageSettings.Visible = (activeIndex == 2)
	pageLogs.Visible = (activeIndex == 3)

	local tabs = { tabTargetsBtn, tabSettingsBtn, tabLogsBtn }
	for i, b in ipairs(tabs) do
		local active = (i == activeIndex)
		b.BackgroundColor3 = active and Color3.fromRGB(79, 70, 229) or Color3.fromRGB(28, 33, 46)
		b.TextColor3 = active and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(148, 163, 184)
	end

	if activeIndex == 3 then
		scrollLogsToBottom()
	end
end

