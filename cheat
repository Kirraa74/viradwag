local listeningHotkey = false
do
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, -6, 0, 32)
	row.BackgroundColor3 = Color3.fromRGB(22, 26, 36)
	row.Parent = pageSettings
	Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)
	addStroke(row, Color3.fromRGB(38, 46, 66), 1)

	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(0.65, -12, 1, 0)
	lbl.Position = UDim2.new(0, 12, 0, 0)
	lbl.BackgroundTransparency = 1
	lbl.Font = Enum.Font.GothamMedium
	lbl.TextSize = 12
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.TextColor3 = Color3.fromRGB(226, 232, 240)
	lbl.Text = "Скрыть / показать меню"
	lbl.Parent = row

	local keyBtn = Instance.new("TextButton")
	keyBtn.Size = UDim2.new(0, 110, 0, 22)
	keyBtn.Position = UDim2.new(1, -118, 0.5, -11)
	keyBtn.BackgroundColor3 = Color3.fromRGB(49, 46, 129)
	keyBtn.Font = Enum.Font.GothamBold
	keyBtn.TextSize = 11
	keyBtn.TextColor3 = Color3.fromRGB(224, 231, 255)
	keyBtn.Parent = row
	Instance.new("UICorner", keyBtn).CornerRadius = UDim.new(0, 5)
	addStroke(keyBtn, Color3.fromRGB(99, 102, 241), 1)

	local function paintKey()
		keyBtn.Text = listeningHotkey and "Нажми клавишу..." or State.hotkey
	end
	paintKey()
	table.insert(settingsRefreshers, paintKey)

	keyBtn.MouseButton1Click:Connect(function()
		listeningHotkey = true
		paintKey()
	end)

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if not isActiveInstance() then
			return
		end
		if listeningHotkey and input.UserInputType == Enum.UserInputType.Keyboard then
			if input.KeyCode ~= Enum.KeyCode.Unknown then
				State.hotkey = input.KeyCode.Name
				listeningHotkey = false
				paintKey()
				saveConfig()
				pushLog("Клавиша меню изменена на: " .. State.hotkey)
			end
			return
		end

		if not gameProcessed and input.UserInputType == Enum.UserInputType.Keyboard then
			if input.KeyCode.Name == State.hotkey then
				mainFrame.Visible = not mainFrame.Visible
			end
		end
	end)
end

