local function makeTabButton(text, index, count)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1 / count, -4, 1, -4)
	btn.Position = UDim2.new((index - 1) / count, 2, 0, 2)
	btn.BackgroundColor3 = index == 1 and Color3.fromRGB(79, 70, 229) or Color3.fromRGB(28, 33, 46)
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 11
	btn.TextColor3 = index == 1 and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(148, 163, 184)
	btn.Text = text
	btn.Parent = tabBar
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)
	return btn
end

