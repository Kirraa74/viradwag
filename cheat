-- Удаление старых экземпляров UI перед запуском (Single Instance)
local function getUiParent()
	local coreOk, coreGui = pcall(function()
		return game:GetService("CoreGui")
	end)
	if coreOk and coreGui then
		local testOk = pcall(function()
			local f = Instance.new("Folder")
			f.Parent = coreGui
			f:Destroy()
		end)
		if testOk then
			return coreGui
		end
	end
	return LocalPlayer:WaitForChild("PlayerGui")
end

local function cleanupPreviousUi()
	local parent = getUiParent()
	for _, obj in ipairs(parent:GetChildren()) do
		if obj.Name == UI_NAME then
			pcall(function()
				obj:Destroy()
			end)
		end
	end
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	if pg then
		for _, obj in ipairs(pg:GetChildren()) do
			if obj.Name == UI_NAME then
				pcall(function()
					obj:Destroy()
				end)
			end
		end
	end
end

