local function loadConfig()
	if not hasFileIO() then
		return false
	end
	local existsOk, exists = pcall(isfile, CONFIG_FILE)
	if not existsOk or not exists then
		return false
	end
	local rOk, raw = pcall(readfile, CONFIG_FILE)
	if not rOk or type(raw) ~= "string" then
		return false
	end
	local dOk, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
	if dOk and type(decoded) == "table" then
		if type(decoded.autoBuy) == "boolean" then State.autoBuy = decoded.autoBuy end
		if type(decoded.autoTeleport) == "boolean" then State.autoTeleport = decoded.autoTeleport end
		if type(decoded.soundAlert) == "boolean" then State.soundAlert = decoded.soundAlert end
		if tonumber(decoded.skinDelay) then State.skinDelay = math.max(0.05, tonumber(decoded.skinDelay)) end
		if tonumber(decoded.loopDelay) then State.loopDelay = math.max(0.05, tonumber(decoded.loopDelay)) end
		if tonumber(decoded.tpWait) then State.tpWait = math.max(1, tonumber(decoded.tpWait)) end
		if tonumber(decoded.tpCooldown) then State.tpCooldown = math.max(5, tonumber(decoded.tpCooldown)) end
		if tonumber(decoded.buyRetries) then State.buyRetries = math.clamp(math.floor(tonumber(decoded.buyRetries)), 0, 5) end
		if tonumber(decoded.minPrice) then State.minPrice = math.max(0, tonumber(decoded.minPrice)) end
		if type(decoded.prioritySkin) == "string" and decoded.prioritySkin ~= "" then
			State.prioritySkin = decoded.prioritySkin
		end
		if tonumber(decoded.foundCount) then State.foundCount = math.max(0, tonumber(decoded.foundCount)) end
		if tonumber(decoded.boughtCount) then State.boughtCount = math.max(0, tonumber(decoded.boughtCount)) end
		if type(decoded.hotkey) == "string" and Enum.KeyCode[decoded.hotkey] then
			State.hotkey = decoded.hotkey
		end

		if type(decoded.seenOrder) == "table" then
			State.seenEntries = {}
			State.seenOrder = {}
			for _, key in ipairs(decoded.seenOrder) do
				if type(key) == "string" then
					markEntrySeen(key)
				end
			end
		end

		if type(decoded.targets) == "table" then
			local cleanTargets = {}
			for k, v in pairs(decoded.targets) do
				local num = tonumber(v)
				if type(k) == "string" and k ~= "" and num and num > 0 then
					cleanTargets[k] = num
				end
			end
			if next(cleanTargets) ~= nil then
				State.targets = cleanTargets
			end
		end

		if refreshTargetsUI then
			refreshTargetsUI()
		end
		refreshSettingsUI()
		updateCounters()

		local wasRunning = decoded.running == true
		pushLog(string.format("Конфиг загружен | Найдено: %d | Куплено: %d", State.foundCount, State.boughtCount))
		if State.prioritySkin then
			pushLog("Приоритет после телепорта: " .. State.prioritySkin)
		end
		return wasRunning
	end
	return false
end

local function getSellerName(item)
	if typeof(item.Seller) == "Instance" then
		return item.Seller.Name
	end
	for _, field in ipairs({ "SellerName", "SellerDisplayName", "OwnerName", "PlayerName", "Username", "Seller" }) do
		if type(item[field]) == "string" and item[field] ~= "" then
			return item[field]
		end
	end
	for _, idField in ipairs({ "SellerUserId", "OwnerId", "UserId", "PlayerId" }) do
		local uid = tonumber(item[idField])
		if uid then
			local plr = Players:GetPlayerByUserId(uid)
			if plr then
				return plr.Name
			end
			return "ID:" .. tostring(uid)
		end
	end
	return "Неизвестно"
end

local function findSellerPlayer(item)
	if typeof(item.Seller) == "Instance" and item.Seller:IsA("Player") then
		return item.Seller
	end
	for _, idField in ipairs({ "SellerUserId", "OwnerId", "UserId", "PlayerId" }) do
		if item[idField] ~= nil then
			local uid = tonumber(item[idField])
			if uid then
				return Players:GetPlayerByUserId(uid)
			end
		end
	end
	for _, nameField in ipairs({ "SellerName", "OwnerName", "PlayerName", "Seller" }) do
		if type(item[nameField]) == "string" then
			local plr = Players:FindFirstChild(item[nameField])
			if plr then
				return plr
			end
		end
	end
	return nil
end

