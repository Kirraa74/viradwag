-- Формирование очереди целей с учётом приоритетного скина после телепорта
local function buildScanQueue()
	local queue = {}
	if State.prioritySkin and State.targets[State.prioritySkin] ~= nil then
		table.insert(queue, { skinId = State.prioritySkin, maxPrice = State.targets[State.prioritySkin] })
	end
	for skinId, maxPrice in pairs(State.targets) do
		if skinId ~= State.prioritySkin then
			table.insert(queue, { skinId = skinId, maxPrice = maxPrice })
		end
	end
	return queue
end

-- Основной цикл работы
task.spawn(function()
	while isActiveInstance() do
		if State.running then
			local queue = buildScanQueue()
			for _, entry in ipairs(queue) do
				if not isActiveInstance() or not State.running then
					break
				end

				local skinId = entry.skinId
				local maxPrice = entry.maxPrice

				setStatus("ПОИСК", Color3.fromRGB(125, 211, 252))
				local ok, results = pcall(invokeSearch, skinId)

				if not isActiveInstance() then
					break
				end

				if ok and type(results) == "table" then
					for _, item in pairs(results) do
						if not isActiveInstance() or not State.running then
							break
						end

						local price = type(item) == "table" and tonumber(item.Price) or nil
						if price and price >= State.minPrice and price <= maxPrice then
							setStatus("НАЙДЕН", Color3.fromRGB(52, 211, 153))
							local entryKey = item.EntryId ~= nil and tostring(item.EntryId)
								or (skinId .. "_" .. tostring(price) .. "_" .. tostring(item.JobId))
							local sellerLabel = getSellerName(item)

							if markEntrySeen(entryKey) then
								State.foundCount += 1
								updateCounters()
								saveConfig()
								pushLog(string.format("НАЙДЕНО: %s | %d | Продавец: %s", skinId, price, sellerLabel))
							end

							if type(item.JobId) == "string" and item.JobId ~= "" and item.JobId ~= game.JobId then
								if State.autoTeleport then
									if isJobCoolingDown(item.JobId) then
										pushLog("Пропуск JobId на кулдауне: " .. item.JobId)
									else
										setStatus("ТЕЛЕПОРТ", Color3.fromRGB(250, 204, 21))
										State.prioritySkin = skinId
										saveConfig(true)
										State.running = false
										local tpOk, tpErr = pcall(invokeTeleport, item.JobId)
										if tpOk then
											pushLog("Телепорт -> " .. skinId .. " (" .. item.JobId .. ")")
											task.wait(State.tpWait)
											if not isActiveInstance() then
												break
											end
											markJobBad(item.JobId)
											setRunning(true, false)
											pushLog("Телепорт не сработал, JobId на кулдауне")
										else
											markJobBad(item.JobId)
											setRunning(true, false)
											pushLog("Ошибка телепорта: " .. tostring(tpErr))
										end
									end
								end
							else
								if State.autoBuy then
									local sellerPlayer = findSellerPlayer(item)
									if sellerPlayer and item.EntryId ~= nil then
										setStatus("ПОКУПКА", Color3.fromRGB(167, 139, 250))
										local attempts = State.buyRetries + 1
										local boughtOk = false
										local lastRes = nil

										for attempt = 1, attempts do
											local buyOk, buyRes = pcall(invokePurchase, sellerPlayer, item.EntryId)
											lastRes = buyRes
											if buyOk and buyRes ~= false and buyRes ~= nil then
												boughtOk = true
												break
											end
											if attempt < attempts then
												task.wait(0.25)
											end
										end

										if boughtOk then
											State.boughtCount += 1
											if State.prioritySkin == skinId then
												State.prioritySkin = nil
											end
											updateCounters()
											saveConfig()
											playAlert()
											pushLog(string.format("КУПЛЕНО: %s | %d | Продавец: %s", skinId, price, sellerPlayer.Name))
										else
											pushLog(string.format("Не куплено %s у %s (%s)", skinId, sellerPlayer.Name, tostring(lastRes)))
										end
										setStatus("ПОИСК", Color3.fromRGB(125, 211, 252))
									end
								end
							end
						end
					end
				elseif not ok then
					pushLog("Ошибка поиска (" .. skinId .. "): " .. tostring(results))
				end

				if not isActiveInstance() or not State.running then
					break
				end
				task.wait(State.skinDelay)
			end

			if isActiveInstance() and State.running then
				setStatus("ОЖИДАНИЕ", Color3.fromRGB(148, 163, 184))
			end
		end

		task.wait(State.loopDelay)
	end
end)

