end

local function hasIO()
	return typeof(writefile) == "function"
		and typeof(readfile) == "function"
		and typeof(isfile) == "function"
end

local function readNum(val, minV, maxV, isInt)
	local n = tonumber(val)
	if not n then
		return nil
	end
	if isInt then
		n = math.floor(n)
	end
	if minV then
		n = math.max(minV, n)
	end
	if maxV then
		n = math.min(maxV, n)
	end
	return n
end

